// Cloudflare: aplikácia je statická stránka (HTML + JS), ktorú Cloudflare
// rozosiela z najbližšieho servera. "single-page-application" znamená, že
// akákoľvek adresa (napr. /join/abc) vráti index.html a o zvyšok sa postará React.
{
  "name": "basket-harmony-v2",
  "compatibility_date": "2026-10-01",
  // Verejná adresa *.workers.dev zapnutá. Náhľadové adresy zapnuté, aby každá
  // testovacia vetva (napr. design/…) mala vlastnú adresu a ostrá appka na main
  // ostala nedotknutá.
  "workers_dev": true,
  "preview_urls": true,
  // Testovacie vetvy staví Cloudflare príkazom `wrangler preview`, ktorý tento
  // blok vyžaduje. Prázdny = testovacia verzia má rovnaké nastavenia ako ostrá.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
